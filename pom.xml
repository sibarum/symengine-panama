<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>sibarum.symengine</groupId>
    <artifactId>symengine-panama</artifactId>
    <version>0.1.0-SNAPSHOT</version>

    <name>symengine-panama</name>
    <description>
        Panama (FFM) bindings for the SymEngine symbolic algebra library. Hand-written downcalls over
        symengine's C API (cwrapper.h) — no jextract, no JNI. The native DLLs are built from source in
        native/ (see native/build.sh) and bundled into the jar from native/dist/bin at package time;
        at runtime they are extracted to a temp dir and loaded in dependency order.
    </description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.11.4</junit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- Bundle the native build output (not committed to git) into the jar. -->
            <resource>
                <directory>native/dist/bin</directory>
                <targetPath>natives/windows-x86_64</targetPath>
                <includes>
                    <include>*.dll</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <target>${maven.compiler.release}</target>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- On Linux the build goes to target-linux/, not target/: the Windows host and a Linux VM build the same checkout
             (a shared folder), and each keeps its own output beside the other's instead of overwriting it. -->
        <profile>
            <id>linux-build-output</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>linux</name>
                </os>
            </activation>
            <build>
                <directory>${project.basedir}/target-linux</directory>
            </build>
        </profile>
    </profiles>
</project>
